{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tekweaver.ca/vanguard-collective/schemas/mission-event/1.1",
  "title": "mission-event",
  "description": "One line of .mission-runtime/telemetry/events.jsonl (expanded-schemas §14, ADR-045). Additive only. 1.1: a mission_snapshot line of schema_version 1.1 or later carries each milestone's status as passed, active, pending or withdrawn; a 1.0 line is read as 1.0 wrote it.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "mission_id", "host_id", "seq", "ts", "kind", "payload", "source_path", "sha256", "commit"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "mission_id":     { "type": "string", "minLength": 1 },
    "host_id":        { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "seq":            { "type": "integer", "minimum": 1 },
    "ts":             { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "kind":           { "type": "string", "minLength": 1 },
    "payload":        { "type": "object", "additionalProperties": true },
    "source_path":    { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)[^/\\\\].*$" },
    "sha256":         { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit":         { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "tool_call" } } },
      "then": { "properties": { "payload": { "required": ["tool", "exit_code", "paths", "session_id", "dispatch_id"],
        "properties": { "tool": { "type": "string" }, "exit_code": { "type": ["integer", "null"] },
          "paths": { "type": "array", "items": { "type": "string" } }, "session_id": { "type": "string" }, "dispatch_id": { "type": ["string", "null"] } },
        "not": { "anyOf": [ { "required": ["stdout"] }, { "required": ["stderr"] }, { "required": ["command"] } ] } } } } },
    { "if": { "properties": { "kind": { "const": "session_start" } } },
      "then": { "properties": { "payload": { "required": ["session_id", "dispatch_id"] } } } },
    { "if": { "properties": { "kind": { "const": "session_stop" } } },
      "then": { "properties": { "payload": { "required": ["session_id", "dispatch_id", "manifest_state", "entry_count"],
        "properties": { "manifest_state": { "enum": ["ABSENT", "PARTIAL", "FINALIZED", "TAMPERED"] }, "entry_count": { "type": "integer", "minimum": 0 } } } } } },
    { "if": { "properties": { "kind": { "const": "compact" } } },
      "then": { "properties": { "payload": { "required": ["session_id", "transcript_sha256"],
        "properties": { "transcript_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } } } },
    { "if": { "properties": { "kind": { "const": "dispatch_opened" } } },
      "then": { "properties": { "payload": { "required": ["dispatch_id", "kind", "feature", "assertion_targets"],
        "properties": { "assertion_targets": { "type": "array", "items": { "type": "string" } } } } } } },
    { "if": { "properties": { "kind": { "const": "dispatch_finalized" } } },
      "then": { "properties": { "payload": { "required": ["dispatch_id", "manifest_state", "partial"],
        "properties": { "manifest_state": { "enum": ["ABSENT", "PARTIAL", "FINALIZED", "TAMPERED"] }, "partial": { "type": "boolean" } } } } } },
    { "if": { "properties": { "kind": { "const": "spec_bumped" } } },
      "then": { "properties": { "payload": { "required": ["from_version", "to_version", "amendment_id"] } } } },
    { "if": { "properties": { "kind": { "const": "ledger_row" } } },
      "then": { "properties": { "payload": { "required": ["entry", "row", "type"], "properties": { "entry": { "type": "integer" }, "row": { "type": ["integer", "null"] } } } } } },
    { "if": { "properties": { "kind": { "enum": ["gate_minted", "gate_expired"] } } },
      "then": { "properties": { "payload": { "required": ["gate_id", "kind", "expires_at"] } } } },
    { "if": { "properties": { "kind": { "const": "gate_consumed" } } },
      "then": { "properties": { "payload": { "required": ["gate_id", "kind", "expires_at", "consumed_at"] } } } },
    { "if": { "properties": { "kind": { "const": "halt_raised" } } },
      "then": { "properties": { "payload": { "required": ["halt_id", "severity"] } } } },
    { "if": { "properties": { "kind": { "const": "halt_resolved" } } },
      "then": { "properties": { "payload": { "required": ["halt_id", "severity", "resolution"],
        "properties": { "resolution": { "enum": ["ANSWERED", "RESOLVED", "WITHDRAWN"] } } } } } },
    { "if": { "properties": { "kind": { "const": "assertion_result" } } },
      "then": { "properties": { "payload": { "required": ["assertion_id", "feature", "result", "round", "validator_kind"],
        "properties": { "result": { "enum": ["green", "red", "skipped"] }, "round": { "type": "integer", "minimum": 1 }, "validator_kind": { "enum": ["narrow", "qa"] } } } } } },
    { "if": { "properties": { "kind": { "const": "verify_result" } } },
      "then": { "properties": { "payload": { "required": ["verdict", "arms_run", "against", "divergences"],
        "properties": { "arms_run": { "type": "array", "items": { "type": "string" } }, "divergences": { "type": "integer", "minimum": 0 } } } } } },
    { "if": { "properties": { "kind": { "const": "tip_observed" } } },
      "then": { "properties": { "payload": { "required": ["local_tip", "origin_tip", "ahead", "behind", "cached"],
        "properties": { "origin_tip": { "type": ["string", "null"] }, "ahead": { "type": ["integer", "null"] }, "behind": { "type": ["integer", "null"] }, "cached": { "type": "boolean" } } } } } },
    { "if": { "properties": { "kind": { "const": "mission_snapshot" } } },
      "then": { "properties": { "payload": { "required": ["state", "current_milestone", "features", "assertions", "counts", "snapshot_sha256"],
        "properties": { "features": { "type": "object" }, "assertions": { "type": "object" },
          "counts": { "type": "object", "required": ["features", "assertions", "open_halts", "open_dispatches"] },
          "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } } } },
    { "if": { "required": ["schema_version"], "properties": { "kind": { "const": "mission_snapshot" }, "schema_version": { "not": { "const": "1.0" } } } },
      "then": { "properties": { "payload": { "properties": { "milestones": { "type": "object",
        "additionalProperties": { "type": "object", "properties": { "status": { "enum": ["passed", "active", "pending", "withdrawn"] } } } } } } } } }
  ]
}
