#Requires -Version 5.1
<#
.SYNOPSIS
  SAMPLE-SUITE instrument v1 -- a sample arc's canonical suite (a synthetic fixture of the framework).

.DESCRIPTION
  THE EXIT CODE IS THE CONTRACT: 0 = every member run passed, non-zero = the number that failed.
  That value is what the goal's `instrument_exit0` detector reads and what the runner records as
  `suite.exit_code`, so nothing else may decide it.

  TWO MEMBERS, AND THEY MEASURE DIFFERENT THINGS.
    M1  THE MIRROR RE-DERIVATION. `.mission/green-gate/product.json` is the GOVERNING home of the
        expected-failure set; `tools/mission-cli/config/expected-failures.yaml` is its DERIVED
        MIRROR. M1 re-derives the mirror's bytes from the manifest and compares BYTE FOR BYTE. A
        mirror that has drifted from its governing home is a manifest that says two things, and the
        runner's expected-failure reader and verify's `count > 0` side both read the mirror -- so drift
        here is drift in what every gate downstream believes.
    M2  THE PRODUCT GREEN GATE, BY ITS OWN INVOCATION. It runs the suite the way the framework's own
        gate runs it and applies the same three conjuncts, so a green M2 means what a green close
        meant.

  ROOT RESOLUTION IS FROM THE SCRIPT, NEVER THE CURRENT DIRECTORY. The runner Push-Locations
  into the dispatch's WORKTREE before invoking a suite, so a suite that resolved its root from the
  working directory would measure the worktree or the mission root depending on who called it.
  $PSScriptRoot\..\.. always names THE TREE THIS FILE IS IN, which is the tree the dispatch is
  working in and the tree the anchors are about.

  THE `FAILED <node-id>` LINES ARE PASSED THROUGH VERBATIM. The cured runner (its expected-failure
  reader) derives `suite.expected_failures_matched` by matching `^FAILED\s+(\S+)` over this script's own
  output against the mirror's declared set. Summarising them, re-formatting them, or printing only a
  count would leave the runner with nothing to measure, and the member would record `true` for a run
  that failed on tests nobody expected.

.PARAMETER Member
  M1, M2, or all (default). Invoked with NO arguments -- the canonical form the runner uses -- it
  runs everything. The switch exists so that falsifying M1 need not pay for M2 twice. It cannot make
  a member pass that would otherwise fail: each verdict is computed from that member's own evidence,
  and the exit code counts only the members that ran.
#>
[CmdletBinding()]
param(
    [ValidateSet('M1', 'M2', 'all')]
    [string]$Member = 'all'
)

$ErrorActionPreference = 'Stop'

$root     = (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path
$manifest = Join-Path $root '.mission\green-gate\product.json'
$mirror   = Join-Path $root 'tools\mission-cli\config\expected-failures.yaml'

$failures = 0
function Write-Member {
    param([string]$Id, [bool]$Ok, [string]$What)
    $tag = if ($Ok) { 'PASS' } else { 'FAIL' }
    if (-not $Ok) { $script:failures++ }
    Write-Host "$tag $Id -- $What"
}

Write-Host "=============================================================================="
Write-Host " SAMPLE-SUITE INSTRUMENT v1 -- the mirror re-derivation and the product green gate"
Write-Host "=============================================================================="
Write-Host "root     : $root"
Write-Host "manifest : $manifest"
Write-Host "mirror   : $mirror"
Write-Host "member   : $Member"
Write-Host ""

# ------------------------------------------------------------------------------------------------
# the mirror's declared set, read the way the cured runner reads it
# ------------------------------------------------------------------------------------------------
# M2 judges its FAILED ids against THE MIRROR rather than against the manifest, deliberately. The
# mirror is what the runner's expected-failure reader consults and what verify's derived side counts, so
# M2 answers the question those two will be asked. M1 is what keeps the mirror honest about its
# governing home. The two members together are the whole claim and either alone is half of it.
#
# $null means the file is ABSENT (it declares nothing); an empty array means it is present and
# declares none. Collapsing those two into one value would erase the distinction M2 turns on.
function Read-DeclaredExpectedFailures {
    param([string]$Path)
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
    $ids = New-Object System.Collections.Generic.List[string]
    $inBlock = $false
    foreach ($line in [System.IO.File]::ReadAllLines($Path)) {
        if ($line -match '^\s*#') { continue }
        if ($line -match '^expected_failures:\s*(.*)$') {
            # $Matches is GLOBAL and the next -match overwrites it, so take the capture out first.
            $rest = $Matches[1].Trim()
            $inBlock = $false
            if ($rest -match '^\[(.*)\]$') {
                $inner = $Matches[1].Trim()
                if ($inner) {
                    foreach ($part in ($inner -split ',')) {
                        $t = $part.Trim().Trim('"').Trim("'")
                        if ($t) { [void]$ids.Add($t) }
                    }
                }
            } elseif (-not $rest) {
                $inBlock = $true
            }
            continue
        }
        if ($inBlock) {
            if ($line -match '^\s+-\s*(.*)$') {
                $t = $Matches[1].Trim().Trim('"').Trim("'")
                if ($t) { [void]$ids.Add($t) }
                continue
            }
            if ($line.Trim() -eq '') { continue }
            $inBlock = $false
        }
    }
    return , $ids.ToArray()
}

function Read-ProductManifest {
    if (-not (Test-Path -LiteralPath $manifest -PathType Leaf)) { return $null }
    return ([System.IO.File]::ReadAllText($manifest) | ConvertFrom-Json)
}

# ================================================================================================
# M1 -- THE MIRROR RE-DERIVATION
# ================================================================================================
function Invoke-M1 {
    $manPresent = Test-Path -LiteralPath $manifest -PathType Leaf
    $mirPresent = Test-Path -LiteralPath $mirror -PathType Leaf
    if (-not $manPresent -or -not $mirPresent) {
        # ABSENT IS A FAILURE, NEVER A SKIP. A member that reports "nothing to compare" when its
        # governing home is missing is a green light bought with a deleted file.
        Write-Member -Id 'M1' -Ok $false -What "the mirror could not be re-derived: manifest present=$manPresent, mirror present=$mirPresent"
        return
    }

    $doc = Read-ProductManifest
    $ids = @($doc.expected_failure_test_ids)

    # THE BYTES, BUILT EXACTLY AS THE MIRROR'S FORMAT SPECIFIES THEM: LF only, no BOM, one terminal LF,
    # the ids IN THE MANIFEST'S ORDER. Single-quoted literals throughout -- the first line carries
    # backticks, which a double-quoted PowerShell string would read as escapes and swallow.
    $lines = New-Object System.Collections.Generic.List[string]
    [void]$lines.Add('# DERIVED MIRROR of .mission/green-gate/product.json `expected_failure_test_ids` (the GOVERNING home).')
    [void]$lines.Add('# Re-derived at every close; tests/lam/instrument-sample-suite.ps1 FAILS on any byte difference.')
    [void]$lines.Add('expected_failures:')
    foreach ($id in $ids) { [void]$lines.Add('  - ' + [string]$id) }
    $expectedText  = ($lines -join "`n") + "`n"
    $expectedBytes = (New-Object System.Text.UTF8Encoding($false)).GetBytes($expectedText)
    $actualBytes   = [System.IO.File]::ReadAllBytes($mirror)

    # BYTE FOR BYTE, over the RAW bytes -- not over lines, and not after any normalisation. Reading
    # the two as text and comparing strings would silently equate an LF file with a CRLF one, which
    # is the exact drift this member exists to catch (see the autocrlf note below).
    $firstDiff = -1
    $n = [Math]::Min($expectedBytes.Length, $actualBytes.Length)
    for ($i = 0; $i -lt $n; $i++) {
        if ($expectedBytes[$i] -ne $actualBytes[$i]) { $firstDiff = $i; break }
    }
    if ($firstDiff -lt 0 -and $expectedBytes.Length -ne $actualBytes.Length) { $firstDiff = $n }
    $same = ($firstDiff -lt 0)

    if ($same) {
        Write-Member -Id 'M1' -Ok $true -What "the mirror is byte-identical to the bytes re-derived from the manifest's $($ids.Count) expected_failure_test_ids ($($expectedBytes.Length) bytes, LF-only, no BOM)"
    } else {
        Write-Member -Id 'M1' -Ok $false -What "the mirror DIFFERS from the bytes re-derived from the manifest: re-derived $($expectedBytes.Length) bytes, on disk $($actualBytes.Length) bytes, first difference at offset $firstDiff"
        # NAMED, NOT MERELY COUNTED. A byte count tells a reader that something moved; the two bytes
        # and the line they fall on tell them WHAT moved, which is the difference between a report
        # that can be acted on and one that can only be re-run.
        $ex = if ($firstDiff -lt $expectedBytes.Length) { '0x{0:X2}' -f $expectedBytes[$firstDiff] } else { '<past the end of the re-derived bytes>' }
        $ac = if ($firstDiff -lt $actualBytes.Length)   { '0x{0:X2}' -f $actualBytes[$firstDiff] }   else { '<past the end of the file>' }
        $upto = $expectedText.Substring(0, [Math]::Min($firstDiff, $expectedText.Length))
        $lineNo = @($upto -split "`n").Count
        Write-Host "     re-derived byte $ex   on-disk byte $ac   (re-derived line $lineNo)"
        # THE CRLF NOTE IS PRINTED ONLY WHEN THE FILE ACTUALLY CARRIES A CR. A hint offered on every
        # failure is a hint that is wrong most of the time, and a reader who has been told twice that
        # a difference is probably line endings stops reading the offset that says it is not.
        if ($actualBytes -contains 13) {
            Write-Host '     THE ON-DISK FILE CONTAINS CR BYTES. This repository sets core.autocrlf=true and the mirror'
            Write-Host '     carries no -text attribute in .gitattributes, so a FRESH CHECKOUT smudges its LF bytes to'
            Write-Host '     CRLF and M1 refuses until the LF bytes are restored. That is this member working, not a'
            Write-Host '     false alarm: the runner and verify both read this file, and a smudged mirror is a mirror'
            Write-Host '     whose bytes are not the bytes the manifest derives.'
        }
    }
}

# ================================================================================================
# M2 -- THE PRODUCT GREEN GATE, BY ITS OWN INVOCATION
# ================================================================================================
function Invoke-M2 {
    $doc = Read-ProductManifest
    if ($null -eq $doc) {
        Write-Member -Id 'M2' -Ok $false -What "the product green-gate manifest is absent at $manifest, so there is no floor to judge against"
        return
    }
    $floor = [int]$doc.stored_floor
    $declared = Read-DeclaredExpectedFailures -Path $mirror
    if ($null -eq $declared) {
        Write-Member -Id 'M2' -Ok $false -What "the mirror is absent at $mirror, so no failure could be judged expected"
        return
    }

    $suiteDir = Join-Path $root 'src'
    if (-not (Test-Path -LiteralPath $suiteDir -PathType Container)) {
        Write-Member -Id 'M2' -Ok $false -What "the suite cwd does not exist: $suiteDir"
        return
    }

    # THE INVOCATION IS tools/mission-lib.ps1:321'S, VERBATIM, INCLUDING THE MODULE FORM. `uv run
    # pytest` goes through the pytest.exe shim, which Windows Application Control blocks here (os
    # error 4551); `python -m pytest` is the same run without the shim and is what the framework's
    # own gate uses. A suite running a DIFFERENT invocation would be measuring something other than
    # what every green close this floor was ratcheted by measured.
    #
    # The first run in a fresh worktree builds the product .venv, because LAM-ACCEPT K-2 excludes
    # venv paths from the worktree include. That is TIME, not a defect: the runner has no suite
    # timeout, and a slow first run must not be read as a hang.
    $started = Get-Date
    $prevEap = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'   # PS 5.1: native stderr is fatal under 'Stop'
    Push-Location $suiteDir
    try {
        $raw  = (& uv run python -m pytest -q -rfE -p no:cacheprovider 2>&1 | Out-String)
        $code = $LASTEXITCODE
    } finally { Pop-Location; $ErrorActionPreference = $prevEap }
    $elapsed = [int]((Get-Date) - $started).TotalSeconds

    # THE TALLY IS PARSED AS Invoke-SuiteDefaultRun PARSES IT (tools/mission-lib.ps1:323-335), down
    # to the deselection rule: Runnable = passed + failed + skipped, and DESELECTED tests are NOT
    # counted. A parser that added them would let the floor be met by tests that never ran.
    $passed = 0; $failed = 0; $skipped = 0; $errs = 0; $desel = 0
    if ($raw -match '(\d+)\s+passed')     { $passed  = [int]$Matches[1] }
    if ($raw -match '(\d+)\s+failed')     { $failed  = [int]$Matches[1] }
    if ($raw -match '(\d+)\s+skipped')    { $skipped = [int]$Matches[1] }
    if ($raw -match '(\d+)\s+error')      { $errs    = [int]$Matches[1] }
    if ($raw -match '(\d+)\s+deselected') { $desel   = [int]$Matches[1] }
    $runnable = $passed + $failed + $skipped

    $failedIds   = @()
    $failedLines = @()
    foreach ($ln in ($raw -split "`r?`n")) {
        if ($ln -match '^FAILED\s+(\S+)') { $failedIds += $Matches[1]; $failedLines += $ln }
    }
    # C3: a COLLECTION-phase error, which is not a runtime test failure and must never be reported
    # as one -- a suite that could not collect has no tally worth comparing to a floor.
    $collErr = ($code -eq 2) -or ($errs -gt 0) -or ($raw -match 'error(s)?\s+during\s+collection') -or ($raw -match '(?m)^ERROR\s')

    # THE PASS-THROUGH, VERBATIM AND BEFORE THE VERDICT, so the runner's reader sees these lines
    # whatever this member concludes about them.
    foreach ($ln in $failedLines) { Write-Host $ln }

    Write-Host "TALLY passed=$passed failed=$failed skipped=$skipped deselected=$desel runnable=$runnable stored_floor=$floor collection_error=$([bool]$collErr) pytest_exit=$code elapsed_seconds=$elapsed"

    # -cnotcontains, not -notcontains: a pytest node id is a case-sensitive identifier and
    # PowerShell's default comparison is case-INSENSITIVE. A case-only difference is a real
    # difference, and refusing on it is the direction that refuses.
    $unexpected = @($failedIds | Where-Object { $declared -cnotcontains $_ })
    $c1 = ($unexpected.Count -eq 0)
    $c2 = ($runnable -ge $floor)
    $c3 = (-not $collErr)
    $bad = @()
    if (-not $c1) { $bad += "C1 unexpected-fail [$($unexpected -join ' ')]" }
    if (-not $c2) { $bad += "C2 collection-regression [runnable $runnable < floor $floor]" }
    if (-not $c3) { $bad += "C3 collection-error [pytest exit $code, errors $errs]" }

    if ($bad.Count -eq 0) {
        Write-Member -Id 'M2' -Ok $true -What "the product suite ran clean: runnable $runnable >= floor $floor, $($failedIds.Count) failure(s) and every one of them declared by the mirror's $($declared.Count) id(s), no collection error"
    } else {
        Write-Member -Id 'M2' -Ok $false -What ("the product green gate is RED: " + ($bad -join '; '))
    }
}

# ================================================================================================
if ($Member -eq 'all' -or $Member -eq 'M1') { Invoke-M1 }
if ($Member -eq 'all' -or $Member -eq 'M2') { Invoke-M2 }

Write-Host ""
Write-Host "------------------------------------------------------------------------------"
Write-Host "EXIT: $failures"
exit $failures
